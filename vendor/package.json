{
  "name": "@fahrenheitresearch/bowecho-radar-toolbox",
  "version": "0.2.0",
  "description": "Client-side BowEcho radar SDK with logical global sites, source failover, and WASM decoding.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FahrenheitResearch/bowecho-radar-toolbox.git",
    "directory": "web"
  },
  "bugs": {
    "url": "https://github.com/FahrenheitResearch/bowecho-radar-toolbox/issues"
  },
  "homepage": "https://github.com/FahrenheitResearch/bowecho-radar-toolbox#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "radar",
    "nexrad",
    "level2",
    "weather",
    "wasm",
    "webgpu",
    "mapbox"
  ],
  "exports": {
    ".": {
      "types": "./radar-toolbox.d.ts",
      "default": "./radar-toolbox.js"
    }
  },
  "types": "./radar-toolbox.d.ts",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "docs",
    "radar-toolbox.js",
    "radar-toolbox.d.ts",
    "global-radar-catalog.js",
    "worker.js",
    "sites.js",
    "examples",
    "relay",
    "tests",
    "pkg"
  ],
  "scripts": {
    "test": "node ./tests/sdk-contract.mjs && node ./tests/universal-contract.mjs && node ./tests/relay-contract.mjs && npm run test:types",
    "test:types": "tsc --noEmit --skipLibCheck false --lib ES2022,DOM --module NodeNext --moduleResolution NodeNext --target ES2022 tests/universal-types.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
